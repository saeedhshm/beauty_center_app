NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Local development credentials only; never reuse outside the local Compose database.
DATABASE_URL=postgresql://lamsa_local:lamsa_local@127.0.0.1:55432/lamsa_dev
DB_POOL_MAX=10
DB_TIMEOUT_MS=3000
# Public MVP demo fixtures. Demo OTP is 123456; no SMS is sent.
AUTH_OTP_MODE=demo
AUTH_SECRET=lamsa-demo-only-auth-secret-not-for-real-users
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=300
# Push notifications are stored and retried; demo mode simulates delivery without sending.
# Use disabled until a real provider adapter is approved.
PUSH_MODE=demo
# Background worker cadence and notification batch size (no secrets here).
WORKER_INTERVAL_MS=30000
WORKER_BATCH_SIZE=50
# Local-disk media root for demo uploads (served only through authenticated API, never static).
STORAGE_DIR=./var/storage
STORAGE_MAX_FILE_BYTES=5242880
